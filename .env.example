# ==============================================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ ДЛЯ MOLDIR NAILS
# Скопируйте этот файл в .env и укажите ваши реальные ключи.
# ВНИМАНИЕ: Файл .env добавлен в .gitignore и никогда не должен попадать в репозиторий.
# ==============================================================================

# 1. Supabase (Settings -> API в панели Supabase)
# Публичные переменные для фронтенда (доступны в браузере):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Секретный ключ службы для Vercel Functions (НИКОГДА не передавать во фронтенд!):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. Telegram Bot (для отправки уведомлений мастеру)
# Получите токен у @BotFather в Telegram:
TELEGRAM_BOT_TOKEN=123456789:AAFg...

# Ваш Chat ID (узнайте через бота @userinfobot):
TELEGRAM_CHAT_ID=123456789
